.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
*_run.log
qwen_download.log
.claude/

# The build spec is the user's private planning doc — never committed.
REDLINE_SPEC.md

# Large/derived data — never committed. dataset/raw/ is user-provided and
# read-only; everything under interim/generated/features is regenerable
# via `make join` / `make generate` / `make features`.
dataset/raw/*.csv
dataset/interim/
dataset/generated/
dataset/features/

# Ollama logs and scratch files from local runs
.ollama_serve.log
.resumability_test.log
ollama_pull.log

# Model artifacts -- except the shipped logistic regression itself
# (dataset/model/logistic_regression.joblib, ~4KB), committed on purpose
# so `make app` / `python -m detector.app.main` works right after
# `make setup`, per the README's quickstart, without requiring anyone
# to first run the multi-hour generation pipeline.
*.pt
*.pkl
*.joblib
!dataset/model/logistic_regression.joblib
